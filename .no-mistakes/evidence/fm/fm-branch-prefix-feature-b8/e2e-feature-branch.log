===== C. fm-review-diff.sh: reviews the task branch under feature/ and under legacy fm/ =====

$ git -C wt branch --list
  * (HEAD detached at refs/heads/main)
    feature/task-x1
  + main
$ fm-review-diff.sh task-x1
  diff base: origin/main
   feature.txt | 1 +
   1 file changed, 1 insertion(+)
  
  diff --git a/feature.txt b/feature.txt
  new file mode 100644
  index 0000000..5acb343
  --- /dev/null
  +++ b/feature.txt
  @@ -0,0 +1 @@
  +change made on feature/task-x1

$ git -C wt branch --list
  * (HEAD detached at refs/heads/main)
    fm/task-x1
  + main
$ fm-review-diff.sh task-x1
  diff base: origin/main
   feature.txt | 1 +
   1 file changed, 1 insertion(+)
  
  diff --git a/feature.txt b/feature.txt
  new file mode 100644
  index 0000000..37521ce
  --- /dev/null
  +++ b/feature.txt
  @@ -0,0 +1 @@
  +change made on fm/task-x1

